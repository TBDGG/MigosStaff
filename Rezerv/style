
@import url('https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap');

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: 'Press Start 2P', cursive;
  background: #1a0a0a;
  color: #f0e6d2;
  min-height: 100vh;
  position: relative;
  overflow-x: hidden;
}

body::before {
  content: "";
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background:
    repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0,0,0,0.03) 2px, rgba(0,0,0,0.03) 4px),
    repeating-linear-gradient(90deg, transparent, transparent 2px, rgba(0,0,0,0.03) 2px, rgba(0,0,0,0.03) 4px),
    linear-gradient(180deg, #3d1c1c 0%, #1a0a0a 50%, #0d0505 100%);
  z-index: -2;
}

.particles {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: -1;
}

.particle {
  position: absolute;
  font-size: 12px;
  color: rgba(255, 180, 50, 0.6);
  animation: float linear infinite;
  user-select: none;
}

@keyframes float {
  0% {
    transform: translateY(100vh) translateX(0px) rotate(0deg);
    opacity: 0;
  }
  10% { opacity: 1; }
  90% { opacity: 1; }
  100% {
    transform: translateY(-100vh) translateX(var(--drift)) rotate(var(--spin));
    opacity: 0;
  }
}

.container {
  width: min(1400px, 95%);
  margin: 0 auto;
  padding: 30px 20px 60px;
}

h1 {
  font-size: 28px;
  color: #ffd700;
  text-shadow: 3px 3px 0 #3d1c1c, 0 0 20px rgba(255, 215, 0, 0.3);
  text-align: center;
  margin-bottom: 10px;
}

.subtitle {
  text-align: center;
  color: #a89070;
  font-size: 11px;
  margin-bottom: 30px;
  text-shadow: 2px 2px 0 #1a0a0a;
}

input, select, button {
  font-family: 'Press Start 2P', cursive;
}

input, select {
  width: 100%;
  padding: 14px 18px;
  border-radius: 0;
  border: 3px solid #5c3a1e;
  background: #2d1810;
  color: #f0e6d2;
  font-size: 11px;
  outline: none;
  box-shadow: inset 3px 3px 0 rgba(0,0,0,0.5), 0 0 0 3px #1a0a0a;
  transition: border-color 0.2s;
}

input:focus, select:focus {
  border-color: #ffd700;
}

input::placeholder {
  color: #6b4f3a;
  font-size: 10px;
}

button {
  padding: 12px 24px;
  border-radius: 0;
  border: 3px solid #5c3a1e;
  background: #3d1c1c;
  color: #c4a882;
  cursor: pointer;
  font-size: 11px;
  box-shadow: inset 2px 2px 0 rgba(255,255,255,0.05), inset -2px -2px 0 rgba(0,0,0,0.3);
  transition: all 0.2s;
  border-bottom: 4px solid #2d1810;
}

button:hover {
  background: #4d2424;
  border-color: #8b5a2b;
  color: #ffd700;
}

button.active {
  background: #5c2a2a;
  border-color: #ffd700;
  color: #ffd700;
  border-bottom: 4px solid #ffd700;
  box-shadow: 0 0 15px rgba(255, 215, 0, 0.3);
}

button.danger {
  border-color: #8b0000;
  color: #ff4444;
}

button.danger:hover {
  background: #4a0000;
  border-color: #ff0000;
  color: #ff6666;
}

/* Формы */
.form-card {
  background: #2d1810;
  border: 3px solid #5c3a1e;
  padding: 30px;
  max-width: 450px;
  margin: 100px auto;
  box-shadow: inset 3px 3px 0 rgba(255,255,255,0.03), inset -3px -3px 0 rgba(0,0,0,0.4), 4px 4px 0 #1a0a0a;
}

.form-card h2 {
  color: #ffd700;
  font-size: 18px;
  text-align: center;
  margin-bottom: 25px;
  text-shadow: 2px 2px 0 #3d1c1c;
}

.form-group {
  margin-bottom: 20px;
}

.form-group label {
  display: block;
  color: #a89070;
  font-size: 10px;
  margin-bottom: 8px;
}

.form-links {
  text-align: center;
  margin-top: 20px;
}

.form-links a {
  color: #8b5a2b;
  font-size: 9px;
  cursor: pointer;
  text-decoration: none;
}

.form-links a:hover {
  color: #ffd700;
}

.error-msg {
  color: #ff4444;
  font-size: 9px;
  text-align: center;
  margin-top: 15px;
  min-height: 20px;
}

.success-msg {
  color: #44ff44;
  font-size: 9px;
  text-align: center;
  margin-top: 15px;
}

/* Навигация */
.nav-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #2d1810;
  border: 3px solid #5c3a1e;
  padding: 15px 25px;
  margin-bottom: 30px;
  box-shadow: 4px 4px 0 #1a0a0a;
  flex-wrap: wrap;
  gap: 15px;
}

.nav-user {
  color: #ffd700;
  font-size: 10px;
  display: flex;
  align-items: center;
  gap: 15px;
  flex-wrap: wrap;
}

.user-mode {
  color: #a89070;
  font-size: 9px;
  background: #3d1c1c;
  padding: 5px 10px;
  border: 2px solid #5c3a1e;
}

.nav-actions {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

/* Таблица */
.table-container {
  background: #2d1810;
  border: 3px solid #5c3a1e;
  padding: 20px;
  box-shadow: 4px 4px 0 #1a0a0a;
  overflow-x: auto;
  margin-bottom: 30px;
}

.table-container h3 {
  color: #ffd700;
  font-size: 14px;
  margin-bottom: 20px;
  text-shadow: 2px 2px 0 #3d1c1c;
}

table {
  width: 100%;
  border-collapse: collapse;
  font-size: 9px;
}

th {
  color: #ffd700;
  text-align: left;
  padding: 12px;
  border-bottom: 2px solid #5c3a1e;
  background: #3d1c1c;
  white-space: nowrap;
}

td {
  padding: 10px 12px;
  border-bottom: 1px solid #3d1c1c;
  color: #c4a882;
}

tr:hover td {
  background: #3d1c1c;
}

.status-approved {
  color: #44ff44;
}

.status-pending {
  color: #ffd700;
}

.status-blocked {
  color: #ff4444;
}

/* Модальное окно */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal {
  background: #2d1810;
  border: 3px solid #ffd700;
  padding: 30px;
  max-width: 500px;
  width: 90%;
  box-shadow: 0 0 30px rgba(255, 215, 0, 0.3);
}

.modal h3 {
  color: #ffd700;
  font-size: 16px;
  margin-bottom: 20px;
  text-align: center;
}

/* Вкладки */
.tabs {
  display: flex;
  gap: 0;
  margin-bottom: 20px;
  flex-wrap: wrap;
}

.tab-btn {
  padding: 10px 18px;
  font-size: 10px;
}

/* Карточки статистики */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 15px;
  margin-bottom: 30px;
}

.stat-card {
  background: #2d1810;
  border: 3px solid #5c3a1e;
  padding: 20px;
  text-align: center;
  box-shadow: 4px 4px 0 #1a0a0a;
}

.stat-value {
  color: #ffd700;
  font-size: 24px;
  margin-bottom: 5px;
}

.stat-label {
  color: #a89070;
  font-size: 8px;
}

.color-picker-wrapper {
  display: flex;
  align-items: center;
  gap: 10px;
}

.color-picker-wrapper input[type="color"] {
  width: 50px;
  height: 40px;
  padding: 0;
  border: 3px solid #5c3a1e;
  cursor: pointer;
  box-shadow: none;
}

/* Адаптивность */
@media (max-width: 768px) {
  h1 { font-size: 18px; }
  .nav-bar { flex-direction: column; text-align: center; }
  .nav-user { flex-direction: column; gap: 10px; }
  th, td { font-size: 7px; padding: 8px; }
  .stats-grid { grid-template-columns: 1fr; }
}

@media (max-width: 480px) {
  h1 { font-size: 14px; }
  .form-card { padding: 20px; margin: 50px auto; }
  .tabs { flex-direction: column; }
}
